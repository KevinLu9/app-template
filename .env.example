# Copy to .env (npm run setup does this). .env is gitignored and never deployed.

# local | test | production. Anything other than "production" is refused when running in Databricks.
APP_ENV=local
LOG_LEVEL=INFO

# --- Lakebase (Postgres) -------------------------------------------------------
# Locally we use the embedded Postgres from `npm run db:up` (no Docker needed). In Databricks, leave DATABASE_URL unset:
# the Lakebase resource injects PGHOST/PGPORT/PGDATABASE/PGUSER/PGSSLMODE and the app
# authenticates with its service principal's OAuth token.
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/app
DB_SCHEMA=app

# --- Databricks (local only) ---------------------------------------------------
# Profile from ~/.databrickscfg (create with: databricks auth login --host <workspace-url>).
# Locally, both the "service principal" and "OBO" examples run as you via this profile.
DATABRICKS_CONFIG_PROFILE=DEFAULT
# SQL warehouse used by the Lakehouse examples (in Databricks this comes from the app resource).
DATABRICKS_WAREHOUSE_ID=

# --- Local identity stub -------------------------------------------------------
# Simulates the X-Forwarded-* headers the Databricks Apps proxy sets. Only honoured when APP_ENV=local.
LOCAL_DEV_USER_EMAIL=developer@example.com
LOCAL_DEV_USER_NAME=Local Developer
LOCAL_DEV_USER_GROUPS=app-users,app-admins
